# Copy to .env to override defaults (docker compose reads it automatically)
PORT=8001
SESSION_TTL_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Live market feed (Finnhub, free tier). Backend-only; never exposed to the browser.
FINNHUB_API_KEY=
# Shared secret so Render Cron Jobs can hit /api/paper/run without a login.
CRON_SECRET=
